{
  "name": "portico-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Portico — desktop app for Windows and macOS",
  "author": "Portico",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:renderer": "vite build --mode electron",
    "build:win": "npm run build:renderer && electron-builder --win --publish never",
    "build:mac": "npm run build:renderer && electron-builder --mac --arm64 --publish never",
    "typecheck": "tsc -b"
  },
  "build": {
    "appId": "com.portico.app",
    "productName": "Portico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icons/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/win/icon.ico",
      "artifactName": "Portico-Setup.exe",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Portico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/mac/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "Portico-arm64.dmg",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Portico"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@xyflow/react": "^12.11.2",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.1",
    "react-hook-form": "^7.84.0",
    "react-pdf": "^10.5.0",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.25",
    "shadcn-ui": "^0.9.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
